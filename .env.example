# ---------------------------------------------------------------------------
# SecureRAG configuration. Copy to .env and fill in. Every variable is optional
# unless marked REQUIRED; defaults are shown.
# ---------------------------------------------------------------------------

# --- Deployment & authentication -------------------------------------------
# ENV=dev + AUTH_MODE=dev enables the demo role switcher (X-Dev-Role header).
# Never use AUTH_MODE=dev on anything reachable by other people.
ENV=dev
# api_key | jwt | dev
AUTH_MODE=dev
# AUTH_MODE=api_key; create keys with scripts/create_api_key.py
API_KEYS_FILE=./data/api_keys.json
# AUTH_MODE=jwt: HS256 | RS256
JWT_ALGORITHM=HS256
# HS256, at least 32 bytes
JWT_SECRET=
# RS256 PEM public key
JWT_PUBLIC_KEY_FILE=
JWT_AUDIENCE=
JWT_ISSUER=
JWT_ROLE_CLAIM=role
# comma-separated; empty = same-origin only
CORS_ORIGINS=
MAX_REQUEST_BYTES=16384
RATE_LIMIT=60/minute
AUDIT_READER_ROLES=admin,exec

# --- Encryption (REQUIRED for anything persistent) --------------------------
# Single key:  python scripts/generate_key.py
SECURERAG_AES_KEY_B64=
# Or a keyring for rotation (takes precedence):
# SECURERAG_KEYRING_FILE=./data/keyring.json
#   {"active": "k2", "index": "k1", "keys": {"k1": "<b64>", "k2": "<b64>"}}
# SECURERAG_ALLOW_V1=true           # set false once rotate_key.py --all has upgraded legacy blobs

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data/sample
# chroma | qdrant
VECTOR_BACKEND=chroma
CHROMA_DIR=./data/chroma_db
# e.g. http://localhost:6333 (server mode)
QDRANT_URL=
# local mode when QDRANT_URL is empty
QDRANT_PATH=./data/qdrant
AUDIT_LOG_PATH=./data/audit.jsonl
AUDIT_MAX_BYTES=10485760

# --- Retrieval & chunking ---------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto | cpu | cuda
EMBED_DEVICE=auto
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=
# capped at the embedding model's window
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K=5
FUSION_K=60
DENSE_CANDIDATES=50
SPARSE_CANDIDATES=50
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=30
CONTEXT_TOKEN_BUDGET=3000
# optional HF model, used at ingest only
INJECTION_CLASSIFIER=

# --- Generation -------------------------------------------------------------
# mock | groq | openai | anthropic | gemini
LLM_PROVIDER=mock
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
